{
  "name": "open-smp",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel exec tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm -C e2e test",
    "build": "pnpm -r build",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.18",
      "sharp@<0.35.0": "^0.35.0",
      "brace-expansion@>=2.0.0 <2.1.3": "^2.1.3"
    }
  }
}
